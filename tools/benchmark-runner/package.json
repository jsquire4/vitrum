{
  "name": "@vitrum/benchmark-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node --check ./*.mjs",
    "test": "npm run typecheck",
    "benchmark": "node ./run-gap-closure-verification.mjs",
    "benchmark:gap-closure": "node ./run-gap-closure-verification.mjs",
    "benchmark:gap-closure-mechanical": "VITRUM_GAP_MECHANICAL=1 node ./run-gap-closure-verification.mjs",
    "benchmark:qualitymodes": "node ./run-quality-mode-bench.mjs",
    "benchmark:lifecycle-soak": "node ./run-lifecycle-soak.mjs",
    "benchmark:wave4-hardening": "node ./run-wave4-hardening.mjs",
    "benchmark:acceptance-metrics": "node ./run-acceptance-metrics.mjs",
    "benchmark:pt-webgl-fidelity": "node ./run-pt-webgl-fidelity-acceptance.mjs",
    "benchmark:wave0-baseline": "node ./run-wave0-baseline.mjs",
    "benchmark:pr-hybrid": "node ./run-pr-hybrid-bench.mjs",
    "benchmark:pr-mechanical": "node ./run-pr-hybrid-mechanical.mjs",
    "benchmark:hybrid-lifecycle-soak": "node ./run-hybrid-lifecycle-soak.mjs",
    "benchmark:pt-webgpu-adapter-probe": "node ./run-pt-webgpu-adapter-probe.mjs",
    "benchmark:capture-pt-webgpu": "node ./capturePtWebgpu.mjs",
    "benchmark:seed-wg0": "node ./run-seed-wg0-baselines.mjs"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
