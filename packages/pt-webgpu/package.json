{
  "name": "@vitrum/pt-webgpu",
  "version": "0.0.0",
  "private": true,
  "description": "WebGPU-native path tracing backend for @vitrum/core (pre-alpha prototype; internal — not production).",
  "keywords": [
    "webgpu",
    "path-tracing",
    "vitrum"
  ],
  "author": "jsquire4",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git",
    "directory": "packages/pt-webgpu"
  },
  "scripts": {
    "test": "vitest run && vitest run --config vitest.gpu.config.ts",
    "test:node": "vitest run",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitrum/core": "file:../core",
    "@vitrum/shared-samplers": "file:../shared-samplers"
  },
  "devDependencies": {
    "@vitest/browser": "^1.6.1",
    "playwright": "^1.59.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1"
  }
}
