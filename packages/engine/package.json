{
  "name": "@vitrum/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in entry point: createEngine() picks a backend, derives defaults from scene AABB, and returns the @vitrum/core Engine contract. Vanilla attachVitrum + React VitrumCanvas helpers included.",
  "keywords": ["webgpu", "webgl2", "path-tracing", "global-illumination", "vitrum", "react"],
  "author": "jsquire4",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":           "./src/index.ts",
    "./gltf":      "./src/gltf.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./react":     "./src/react/index.ts"
  },
  "files": ["src", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git",
    "directory": "packages/engine"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitrum/core": "file:../core",
    "@vitrum/gltf-adapter": "file:../gltf-adapter",
    "@vitrum/walkaround-hybrid": "file:../walkaround-hybrid",
    "@vitrum/pt-webgpu": "file:../pt-webgpu",
    "@vitrum/pt-webgl2": "file:../pt-webgl2"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@webgpu/types": "^0.1.40",
    "react": "^18.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1"
  }
}
