{
  "name": "@vitrum/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in entry point: createEngine() picks a backend, derives defaults from scene AABB, and returns the @vitrum/core Engine contract. Vanilla attachVitrum + React VitrumCanvas helpers included.",
  "keywords": [
    "webgpu",
    "webgl2",
    "path-tracing",
    "global-illumination",
    "vitrum",
    "react",
    "three"
  ],
  "author": "jsquire4",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./react": "./src/react/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git",
    "directory": "packages/engine"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitrum/core": "file:../core",
    "@vitrum/three-bindings": "file:../three-bindings",
    "@vitrum/walkaround-hybrid": "file:../walkaround-hybrid",
    "@vitrum/pt-webgl": "file:../pt-webgl"
  },
  "peerDependencies": {
    "three": ">=0.167.0 <0.190",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": ">=0.167.0 <0.190",
    "@vitejs/plugin-react": "^4.3.0",
    "@webgpu/types": "^0.1.40",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": ">=0.167.0 <0.190",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1"
  }
}
