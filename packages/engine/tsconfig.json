      "@vitrum/shared-samplers": ["../shared-samplers/src/index.ts"],
      "@vitrum/stained-glass-extensions": ["../stained-glass-extensions/src/index.ts"],
      "@vitrum/walkaround-rc": ["../walkaround-rc/src/index.ts"]
