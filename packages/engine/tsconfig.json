{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@vitrum/core": ["../core/src/index.ts"],
      "@vitrum/walkaround-hybrid": ["../walkaround-hybrid/src/index.ts"],
