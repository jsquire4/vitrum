{
  "name": "@vitrum/walkaround-hybrid",
  "version": "0.0.0",
  "private": true,
  "description": "WebGPU layered DDGI + ReSTIR DI/GI engine with per-channel SVGF + GTAO.",
  "keywords": [
    "webgpu",
    "global-illumination",
    "ddgi",
    "restir",
    "svgf",
    "gtao",
    "vitrum"
  ],
  "author": "jsquire4",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git",
    "directory": "packages/walkaround-hybrid"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:node": "vitest run --config vitest.config.ts",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "test:f16": "deno run --unstable-webgpu ../../tools/gpu-env/probe-deno-neural-f16.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.gpu.config.ts && npm run test:f16",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitrum/core": "file:../core",
    "@vitrum/shared-bvh": "file:../shared-bvh",
    "@vitrum/shared-samplers": "file:../shared-samplers",
    "@vitrum/shared-denoisers": "file:../shared-denoisers",
    "@vitrum/walkaround-rc": "file:../walkaround-rc"
  },
  "devDependencies": {
    "@vitrum/stained-glass-extensions": "file:../stained-glass-extensions",
    "@vitest/browser": "^1.6.1",
    "playwright": "^1.59.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1"
  }
}
