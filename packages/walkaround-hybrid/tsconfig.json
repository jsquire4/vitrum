{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@vitrum/core": [
        "../core/src/index.ts"
      ],
      "@vitrum/shared-bvh": [
        "../shared-bvh/src/index.ts"
      ],
      "@vitrum/shared-bvh/*": [
        "../shared-bvh/src/*"
      ],
      "@vitrum/shared-samplers": [
        "../shared-samplers/src/index.ts"
      ],
      "@vitrum/shared-denoisers": [
        "../shared-denoisers/src/index.ts"
      ],
      "@vitrum/stained-glass-extensions": [
        "../stained-glass-extensions/src/index.ts"
      ],
      "@vitrum/walkaround-rc": [
        "../walkaround-rc/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "__tests__"
  ],
  "exclude": [
    "src/neural/nrc/fusedMlpHarness.ts",
    "src/neural/nrc/nrcQueryHarness.ts",
    "src/neural/nrc/nrcEncodeBackwardHarness.ts"
  ]
}
