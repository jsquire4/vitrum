#!/usr/bin/env sh
# vitrum pre-push GPU validation gate (T1 smoke) — WARN-ONLY.
#
# Runs the local real-GPU smoke (shader-compile on both backends + default-render
# non-regression) via the wsl-gpu harness and prints any regression LOUDLY, but
# NEVER blocks the push (the chosen gate hardness — see
# plan/gpu-validation-gate-2026-05-29.md §8). Skips silently when wsl-gpu / a GPU
# isn't present, so non-WSL contributors and CI are unaffected.
#
# Activated by `core.hooksPath = scripts/githooks` (set by scripts/install-git-hooks.mjs
# on npm install). To bypass entirely: `git push --no-verify`.
NODE_BIN="${NODE:-}"
if [ -z "$NODE_BIN" ] || ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  NODE_BIN="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$NODE_BIN" ] && [ -d "$HOME/.nvm/versions/node" ]; then
  NODE_BIN="$(find "$HOME/.nvm/versions/node" -path '*/bin/node' -type f 2>/dev/null | sort -V | tail -n 1)"
fi
if [ -z "$NODE_BIN" ]; then
  echo "[vitrum pre-push] node not found; skipping warn-only GPU smoke." >&2
  exit 0
fi
export NODE="$NODE_BIN"
export PATH="$(dirname "$NODE_BIN"):$PATH"
# (The three-gpu-pathtracer fork was removed 2026-06-09; its shader-smoke wrapper
#  is gone. The native pt-webgl2 GLSL is covered by its own package tests + the
#  GPU smoke below.)
"$NODE_BIN" scripts/validate-gpu.mjs --smoke --warn-only || {
  echo "[vitrum pre-push] GPU smoke wrapper failed; continuing warn-only." >&2
}
exit 0
