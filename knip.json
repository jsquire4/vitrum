{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "_staging/**",
    "plan/**",
    "external_requests/**",
    "tools/reference-renders/**",
    "**/*.wgsl",
    "**/*.glsl",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**"
  ],
  "ignoreBinaries": [],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{js,mjs,ts}",
        "eslint.config.js",
        "tools/gpu-env/*.{ts,mjs,js,mts}"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "src/main.{ts,tsx}",
        "src/**/*Harness.ts",
        "__tests__/**/*.test.{ts,tsx}",
        "__tests__/**/*.spec.{ts,tsx}",
        "src/**/__tests__/**/*.test.{ts,tsx}",
        "src/**/__tests__/**/*.spec.{ts,tsx}",
        "vitest.config.{ts,mjs,js}",
        "vitest.gpu.config.{ts,mjs,js}"
      ]
    },
    "examples/*": {
      "entry": [
        "index.html",
        "src/main.{ts,tsx}",
        "src/index.{ts,tsx}",
        "vite.config.{ts,mjs,js}",
        "__tests__/**/*.test.{ts,tsx}",
        "__tests__/**/*.spec.{ts,tsx}"
      ]
    },
    "tools/*": {
      "entry": [
        "src/index.{ts,mjs,js}",
        "src/main.{ts,mjs,js}",
        "bin/*.{ts,mjs,js}",
        "*.{ts,mjs,js}",
        "generate-wgsl-layouts.mjs",
        "benchmark-runner/*.mjs",
        "benchmark-runner/run-*.mjs"
      ]
    }
  }
}
