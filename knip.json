{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "_staging/**",
    "plan/**",
    "external_requests/**",
    "tools/reference-renders/**",
    "**/*.wgsl",
    "**/*.glsl",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**"
  ],
  "ignoreBinaries": [],
  "eslint": false,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs,ts}"]
    },
    "packages/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "src/main.{ts,tsx}",
        "__tests__/**/*.test.{ts,tsx}",
        "__tests__/**/*.spec.{ts,tsx}",
        "vitest.config.{ts,mjs,js}",
        "vitest.gpu.config.{ts,mjs,js}"
      ]
    },
    "examples/*": {
      "entry": [
        "index.html",
        "src/main.{ts,tsx}",
        "src/index.{ts,tsx}",
        "vite.config.{ts,mjs,js}"
      ]
    },
    "tools/*": {
      "entry": [
        "src/index.{ts,mjs,js}",
        "src/main.{ts,mjs,js}",
        "bin/*.{ts,mjs,js}",
        "*.{ts,mjs,js}"
      ]
    }
  }
}
