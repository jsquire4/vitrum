{
  "name": "vitrum",
  "version": "0.0.0",
  "private": true,
  "description": "WebGPU + WebGL2 path tracing & global illumination engine for the browser. Workspace root.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:gpu": "npm run test:gpu --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present",
    "fork-shader-smoke": "node ./scripts/run-fork-shader-smoke.mjs",
    "shader-compile-ci": "npm run shader-compile-ci --workspace @vitrum/shader-compile-ci",
    "benchmark:gap-closure": "npm run benchmark:gap-closure --workspace @vitrum/benchmark-runner",
    "benchmark:qualitymodes": "npm run benchmark:qualitymodes --workspace @vitrum/benchmark-runner",
    "benchmark:lifecycle-soak": "npm run benchmark:lifecycle-soak --workspace @vitrum/benchmark-runner",
    "baseline:wave0": "npm run benchmark:wave0-baseline --workspace @vitrum/benchmark-runner",
    "hardening:wave4": "npm run benchmark:wave4-hardening --workspace @vitrum/benchmark-runner",
    "benchmark:pr-hybrid": "npm run benchmark:pr-hybrid --workspace @vitrum/benchmark-runner",
    "benchmark:seed-wg0": "npm run benchmark:seed-wg0 --workspace @vitrum/benchmark-runner",
    "benchmark:pr-mechanical": "npm run benchmark:pr-mechanical --workspace @vitrum/benchmark-runner",
    "benchmark:hybrid-lifecycle-soak": "npm run benchmark:hybrid-lifecycle-soak --workspace @vitrum/benchmark-runner",
    "benchmark:pt-webgpu-adapter-probe": "npm run benchmark:pt-webgpu-adapter-probe --workspace @vitrum/benchmark-runner",
    "benchmark:gpu-windows": "node tools/benchmark-runner/run-gpu-host-windows.mjs",
    "verify:mechanical": "npm run typecheck && npm test && npm run fork-shader-smoke && npm run shader-compile-ci && npm run benchmark:rc-acceptance-mechanical && npm run benchmark:bdpt-layered-mechanical",
    "benchmark:gap-closure-mechanical": "npm run benchmark:gap-closure-mechanical --workspace @vitrum/benchmark-runner",
    "benchmark:gap-closure-gpu": "npm run benchmark:gap-closure-gpu --workspace @vitrum/benchmark-runner",
    "benchmark:pr-hybrid-refs": "npm run benchmark:pr-hybrid-refs --workspace @vitrum/benchmark-runner",
    "benchmark:pr-hybrid-gpu": "npm run benchmark:pr-hybrid-gpu --workspace @vitrum/benchmark-runner",
    "benchmark:pr-hybrid-gpu-windows": "node tools/benchmark-runner/run-gpu-host-windows.mjs run-pr-hybrid-gpu-full.mjs VITRUM_PR_REQUIRE_GPU=1",
    "benchmark:rc-acceptance": "npm run benchmark:rc-acceptance --workspace @vitrum/benchmark-runner",
    "benchmark:rc-acceptance-full": "npm run benchmark:rc-acceptance-full --workspace @vitrum/benchmark-runner",
    "benchmark:rc-acceptance-gpu": "node tools/benchmark-runner/run-rc-acceptance-wsl-vite-win-chrome.mjs",
    "benchmark:rc-acceptance-windows": "node tools/benchmark-runner/run-rc-acceptance-wsl-vite-win-chrome.mjs",
    "benchmark:rc-acceptance-mechanical": "npm run benchmark:rc-acceptance-mechanical --workspace @vitrum/benchmark-runner",
    "benchmark:bdpt-layered-refs": "npm run benchmark:bdpt-layered-refs --workspace @vitrum/benchmark-runner",
    "benchmark:bdpt-layered-mechanical": "npm run benchmark:bdpt-layered-mechanical --workspace @vitrum/benchmark-runner",
    "capture:refs": "./scripts/capture-all-refs.sh",
    "capture:refs:quick": "./scripts/capture-all-refs.sh --quick",
    "capture:refs:hero": "./scripts/capture-all-refs.sh --hero",
    "capture:promote-baseline": "./scripts/promote-ref-baseline.sh",
    "capture:diff": "node ./tools/reference-renders/diff-baselines.mjs",
    "release:dry-run": "npm pack --dry-run --workspaces --if-present",
    "codegen:wgsl-layouts": "node ./tools/generate-wgsl-layouts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.3"
  },
  "license": "MIT",
  "author": "jsquire4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git"
  },
  "overrides": {
    "three": "0.171.0"
  }
}
