{
  "name": "vitrum",
  "version": "0.0.0",
  "private": true,
  "description": "WebGPU + WebGL2 path tracing & global illumination engine for the browser. Workspace root.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "validate:gpu:smoke": "node scripts/validate-gpu.mjs --smoke",
    "validate:gpu": "node scripts/validate-gpu.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:gpu": "npm run test:gpu --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present",
    "benchmark:gap-closure": "npm run benchmark:gap-closure --workspace @vitrum/benchmark-runner",
    "benchmark:gap-closure-mechanical": "npm run benchmark:gap-closure-mechanical --workspace @vitrum/benchmark-runner",
    "verify:mechanical": "npm run typecheck && npm test && npm run lint && npm run benchmark:rc-acceptance-mechanical",
    "benchmark:rc-acceptance-mechanical": "npm run benchmark:rc-acceptance-mechanical --workspace @vitrum/benchmark-runner",
    "capture:diff": "node ./tools/reference-renders/diff-baselines.mjs",
    "release:dry-run": "npm pack --dry-run --workspaces --if-present",
    "codegen:wgsl-layouts": "node ./tools/generate-wgsl-layouts.mjs",
    "shader-gate": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env tools/shader-gate/gate.mjs",
    "shader-gate:glsl": "deno run --sloppy-imports --allow-read --allow-env --allow-run --allow-write=/tmp tools/shader-gate/glslGate.mjs",
    "behavioral-gate": "node tools/behavioral-gate/run-gate.mjs",
    "behavioral-gate:dzn": "node tools/behavioral-gate/run-gate-dzn.mjs",
    "behavioral-gate:tlas-glass-shadow": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env tools/behavioral-gate/tlas-glass-shadow-oracle.mjs",
    "behavioral-gate:cwbvh": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write=tools/behavioral-gate tools/behavioral-gate/cwbvh-parity-oracle.mjs",
    "radiometric-ab:sppm": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write tools/radiometric-ab/ab-sppm.mjs",
    "radiometric-ab:bdpt": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write tools/radiometric-ab/ab-bdpt.mjs",
    "radiometric-ab:restir-pt": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write tools/radiometric-ab/ab-restir-pt.mjs",
    "radiometric-ab:restir-pt-glossy-research": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write tools/radiometric-ab/ab-restir-pt-glossy-research.mjs",
    "radiometric-ab:sobol": "deno run --unstable-webgpu --sloppy-imports --allow-read --allow-env --allow-write tools/radiometric-ab/ab-sobol.mjs",
    "radiometric-ab:pt-host-status": "node tools/radiometric-ab/run-pt-ab.mjs",
    "radiometric-ab:restir-pt-specialty": "node tools/radiometric-ab/ab-restir-pt-specialty.mjs --check",
    "radiometric-ab:proof-check": "deno run --sloppy-imports --allow-read tools/radiometric-ab/check-results.mjs",
    "road-to-100-source-gap-scan": "deno run --sloppy-imports --allow-read tools/road-to-100/check-source-gap-markers.mjs",
    "road-to-100-source-check": "deno run --sloppy-imports --allow-read tools/road-to-100/check-ledger.mjs && npm run road-to-100-source-gap-scan && npm run road-to-100-validation-status",
    "road-to-100-validation-status": "deno run --sloppy-imports --allow-read tools/road-to-100/check-validation-queue.mjs",
    "road-to-100-next-actions": "node tools/road-to-100/next-actions.mjs",
    "proof-check": "npm run road-to-100-source-check && npm run gltf-material-proof-check && npm run gltf-real-proof-check && npm run gltf-topology-proof-check && npm run gltf-browser-proof-check && npm run behavioral-gate:dzn-status-check && npm run cwbvh-gpu-proof-check && npm run radiometric-ab:proof-check && npm run radiometric-ab:restir-pt-specialty && npm run renderer-fidelity-proof-check && npm run learned-systems-proof-check",
    "behavioral-gate:dzn-status-check": "deno run --sloppy-imports --allow-read tools/behavioral-gate/check-dzn-status.mjs",
    "cwbvh-gpu-proof-check": "deno run --sloppy-imports --allow-read tools/behavioral-gate/check-cwbvh-parity-status.mjs && deno run --sloppy-imports --allow-read tools/behavioral-gate/check-cwbvh-renderer-parity-status.mjs",
    "learned-systems-proof-check": "deno run --sloppy-imports --allow-read tools/learned-systems/check-status.mjs",
    "learned-systems-status": "deno run --sloppy-imports --allow-read --allow-write=tools/learned-systems/learned-systems-status.json tools/learned-systems/check-status.mjs --write-status",
    "renderer-fidelity-proof-check": "deno run --sloppy-imports --allow-read tools/renderer-fidelity-proof/check-proofs.mjs",
    "radiometric-ab:walkaround": "node tools/radiometric-ab/run-walkaround-ab.mjs",
    "gltf-material-sweep": "deno run --sloppy-imports --allow-read tools/gltf-material-sweep/sweep.mjs",
    "gltf-material-proof-check": "deno run --sloppy-imports --allow-read tools/gltf-material-sweep/check-proofs.mjs",
    "gltf-real-proof-check": "deno run --sloppy-imports --allow-read tools/gltf-real-asset-sweep/check-proofs.mjs",
    "gltf-browser-proof-check": "deno run --sloppy-imports --allow-read tools/gltf-browser-proof/check-status.mjs",
    "gltf-browser-proof-check:required": "deno run --sloppy-imports --allow-read tools/gltf-browser-proof/check-status.mjs --require-pass",
    "gltf-topology-proof-check": "deno run --sloppy-imports --allow-read tools/gltf-topology-proofs/check-proofs.mjs",
    "gltf-real-asset-sweep": "deno run --sloppy-imports --allow-read --allow-net tools/gltf-real-asset-sweep/sweep.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.2",
    "@webgpu/types": "^0.1.40",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.3"
  },
  "license": "MIT",
  "author": "jsquire4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsquire4/vitrum.git"
  }
}
