  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./legacy-source/src/rendering/scene/lightingIntensityTable.ts",
    "./legacy-source/src/rendering/scene/ptEnvironment.ts",
    "./legacy-source/src/rendering/scene/lighting/renderers/sunPathTraced.tsx",
    "./legacy-source/src/rendering/scene/walkaround/HybridLayeredStage.tsx",
    "./legacy-source/src/rendering/scene/walkaround/engines/restir/RestirStage.tsx",
    "./legacy-source/src/rendering/scene/walkaround/lib/bvhCommon.ts",
    "./legacy-source/src/rendering/scene/walkaround/lib/useSceneBVH.ts"
  ]
}
